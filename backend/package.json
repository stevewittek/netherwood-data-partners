{
  "name": "@netherwood/voyager-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "articles:export": "node --experimental-strip-types src/export-articles.ts",
    "knowledge:ingest": "node --experimental-strip-types src/ingest-knowledge.ts",
    "verify:rag": "node --experimental-strip-types src/verify-rag.ts"
  },
  "dependencies": {
    "html-to-text": "10.0.1",
    "mammoth": "1.12.1",
    "mssql": "12.7.0",
    "pdf-parse": "2.4.5",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/mssql": "12.3.0",
    "@types/node": "22.19.19",
    "@types/sanitize-html": "2.16.1",
    "typescript": "5.9.3"
  }
}
