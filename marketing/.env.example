MARKETING_DB_PATH=data/marketing.sqlite
MARKETING_OUTBOX_DIR=data/outbox
MARKETING_PUBLIC_BASE_URL=http://127.0.0.1:4310
MARKETING_WEBSITE_ORIGIN=https://netherwooddatapartners.com
MARKETING_SENDER_NAME=Netherwood Data Partners
MARKETING_SENDER_EMAIL=marketing@example.test
MARKETING_TEST_RECIPIENT=owner@example.test
MARKETING_POSTAL_ADDRESS=LOCAL TEST ONLY - replace with valid business postal address before any production adapter