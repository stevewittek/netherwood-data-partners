[Unit]
Description=Export, request website publication, and refresh deployed article knowledge
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/netherwood-publication-release
EnvironmentFile=%h/.config/netherwood/publication.env
ExecStart=%h/netherwood-publication-release/ops/articles/publication-cycle.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12min
NoNewPrivileges=true

# Template only. No installation or activation has been performed.
